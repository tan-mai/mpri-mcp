# Caddy obtains and renews the TLS certificate for $DOMAIN automatically.
# The domain's DNS A record must point at this server, and ports 80 + 443 must be open.

{$DOMAIN} {
	encode zstd gzip

	reverse_proxy mpri-mcp:8000 {
		# Pass streamed MCP responses through without buffering.
		flush_interval -1
	}

	log {
		output stdout
		format console
	}
}
