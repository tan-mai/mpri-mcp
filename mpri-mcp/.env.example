# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- Server
# Public origin of this server — exactly what you enter in Claude (without /mcp).
# It is the OAuth issuer, and the connector URL becomes ${PUBLIC_BASE_URL}/mcp.
PUBLIC_BASE_URL=http://localhost:8000
# Domain for Caddy's TLS certificate (production compose only).
DOMAIN=mpri.example.com
LOG_LEVEL=INFO
# Image to run (production compose). Use the sha-… tag from the GitHub Actions run summary
# to pin an exact build; roll back by putting the previous tag here.
MPRI_IMAGE=ghcr.io/tan-mai/mpri-mcp:latest

# ---------------------------------------------------------------- Auth
# Optional: fixed first-run setup token. If empty, a random one is printed in the logs.
ADMIN_SETUP_TOKEN=
# Optional: cookie signing secret. If empty, one is generated into the data volume.
SESSION_SECRET=

# ---------------------------------------------------------------- Scheduler
SCHEDULER_TIMEZONE=Asia/Ho_Chi_Minh
BACKUP_CRON=30 4 * * *
BACKUP_KEEP=7

# TM - #{ticket number} - MPriMCP Agent Crawl & Product Search
# ---------------------------------------------------------------- Agent crawl tasks
# The server fetches no pages: schedules queue crawl tasks and Claude reads the prices with
# the browser. A claimed task is reserved this long, then goes back to the queue.
AGENT_TASK_LEASE_MINUTES=30
# Tasks nobody crawled within this many hours are marked expired.
AGENT_TASK_EXPIRE_HOURS=48
# Claims per task; a result with status "error" re-queues the task until this is reached.
AGENT_TASK_MAX_ATTEMPTS=3
