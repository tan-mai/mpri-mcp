# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- Server
# Public origin of this server — exactly what you enter in Claude (without /mcp).
# It is the OAuth issuer, and the connector URL becomes ${PUBLIC_BASE_URL}/mcp.
PUBLIC_BASE_URL=http://localhost:8000
# Domain for Caddy's TLS certificate (production compose only).
DOMAIN=mpri.example.com
LOG_LEVEL=INFO
# en | vi — dashboard language and the language of new Claude connections until someone
# picks another one (dashboard EN|VI switch, consent screen, or "chuyển sang tiếng Việt").
DEFAULT_LANGUAGE=en

# ---------------------------------------------------------------- AI provider
# Default provider/model for price extraction. The dashboard (AI settings) and each
# supermarket can override these. Providers: gemini | openai | anthropic
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash-lite
# Optional fallback used when the main provider keeps failing (quota, outage).
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=

# Gemini — backend "vertex" (bills the Google Cloud project, uses the $300 trial credit)
# or "studio" (AI Studio API key).
GEMINI_BACKEND=vertex
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Vertex service-account key: put the JSON file at ./secrets/gcp-sa.json — compose mounts
# it and sets GOOGLE_APPLICATION_CREDENTIALS for you.
GEMINI_API_KEY=
# Only send a thinking budget if set (2.5 Flash-Lite has thinking off by default).
GEMINI_THINKING_BUDGET=

# OpenAI or any OpenAI-compatible API (OpenRouter, DeepSeek, Groq, Ollama, vLLM, ...).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_TEMPERATURE=

# Anthropic (Claude models). Pick the model in the dashboard or AI_MODEL, e.g. claude-opus-5-5,
# or claude-haiku-5-5 for the lowest cost per page. Effort low|medium|high (empty = omit).
ANTHROPIC_API_KEY=
ANTHROPIC_EFFORT=low

# ---------------------------------------------------------------- Auth
# Optional: fixed first-run setup token. If empty, a random one is printed in the logs.
ADMIN_SETUP_TOKEN=
# Optional: cookie signing secret. If empty, one is generated into the data volume.
SESSION_SECRET=

# ---------------------------------------------------------------- Scheduler / crawler
SCHEDULER_TIMEZONE=Asia/Ho_Chi_Minh
MAX_CONCURRENT_MARKETS=2
MAX_PAGES_PER_MARKET=3
PAGE_TIMEOUT_SECONDS=45
JOB_TIMEOUT_SECONDS=1800
BACKUP_CRON=30 4 * * *
BACKUP_KEEP=7
