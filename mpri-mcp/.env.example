# TM - #{ticket number} - MPriMCP Rust Rewrite & Self-host
# Copy to .env (next to where you start mprimcp, or next to the compose file). Never commit .env.

# Data directory (default: OS-specific app data folder:
#   Linux ~/.local/share/mprimcp, macOS ~/Library/Application Support/mprimcp, Windows %APPDATA%\mprimcp)
# MPRIMCP_DATA_DIR=

# serve mode only
MPRIMCP_BIND=127.0.0.1:8765
# Public origin your AI client reaches, without /mcp. Required behind a reverse proxy (HTTPS);
# it is the OAuth issuer and the connector URL becomes ${MPRIMCP_PUBLIC_URL}/mcp.
# MPRIMCP_PUBLIC_URL=https://mpri.example.com
# true when running behind a reverse proxy, so login rate limits see the real client IP.
# MPRIMCP_TRUST_PROXY=false

# First-run account for non-interactive starts (Docker/systemd).
# Used only when no account exists yet. Otherwise run: mprimcp user create
# MPRIMCP_ADMIN_USER=
# MPRIMCP_ADMIN_PASSWORD=

# Server-side cron (serve mode only). Default off.
MPRIMCP_CRON_ENABLED=false

# Extra OAuth redirect URIs allowed for MCP clients (comma separated). Claude's callback and
# loopback addresses are always allowed.
# MPRIMCP_OAUTH_REDIRECT_URIS=

# One-time import on the first start of serve/dashboard when the database is still empty:
# path to the Python release's mpri.db (its secrets/ folder next to it is read too).
# MPRIMCP_IMPORT_FROM=

# Log level
RUST_LOG=info
